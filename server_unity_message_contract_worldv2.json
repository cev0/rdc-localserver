    "globalConnectionRequiresBothStatesOpened": true,
    "globalClientMayInventLockedStatesOrNodes": false,
    "globalSearchIsReadOnly": true,
    "resourceCoordinatesAreServerAuthoritative": true,
    "resourceTargetIdChangesOnRespawn": true,
    "resourceDepletionRemovesNodeFromObjectFeed": true,
    "resourceRespawnChoosesNewServerCoordinate": true,
    "resourceReservationAndGatherAreTransactional": true,
    "resourceClientMayNotChooseCoordinatesOrRemainingAmount": true,
    "baseTeleportIsServerAuthoritative": true,
    "baseTeleportOnlyInsideHomeState": true,
    "baseTeleportCollisionValidationIsTransactional": true,
    "baseTeleportClientMayNotMutateWorldPlacement": true
