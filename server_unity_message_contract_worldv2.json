      "note": "Real State qonşuluq ID-ləri müəyyən edilməyənədək dörd sərhəd istiqaməti explicit fail-closed status alır; State ID uydurulmur və keçid icazəsi verilmir."
    },
    "state_map_v2_objects_request": {
      "connected": true,
      "source": "dovlet_baza_kataloqu_postgres + dovlet_xerite_worldv2_resurs_provider",
      "layers": {
        "bases": true,
        "resources": true,
        "enemies": false,
        "camps": false,
        "convoys": false
      },
      "note": "Bazalar PostgreSQL kataloqundan, dinamik WorldV2 resursları server runtime provider-dən gəlir. Resurs koordinatı, level, tutum, targetId/spawnSerial və respawn server-authoritative-dir."
    },
    "state_map_v2_resource_detail_request": {
      "connected": true,
      "source": "dovlet_xerite_worldv2_resurs_emeliyyat_sistemi",
      "readOnly": true,
      "persistentPlacementMutated": false,
      "note": "Cari dinamik resurs spawn-ının tutum, level, koordinat, məşğulluq və timer məlumatını authoritative runtime-dan qaytarır; köhnə targetId fail-closed rədd edilir."
    },
    "convoy_operation_start_request_worldv2_resource": {
      "connected": true,
      "source": "konvoy_emeliyyat_handler + konvoy_emeliyyat_worldv2_override",
      "transactional": true,
      "resourceRuntimeSource": "dovlet_xerite_worldv2_resurs_emeliyyat_sistemi",
      "note": "WorldV2 resurs targetId üçün konvoy dispatch, server reservation, toplama, tutum azalması, tükənmə/respawn və baza mükafatı mövcud konvoy əməliyyat sistemi ilə eyni PostgreSQL player transaction-u daxilində körpülənir."
    },
    "state_map_v2_border_transition_request": {
      "connected": true,
      "readOnly": true,
      "topologySource": "dovlet_xerite_worldv2_topologiya",
      "lifecycleSource": "dovlet_xerite_worldv2_lifecycle_adapteri",
      "entryCoordinateSource": "dovlet_xerite_worldv2_serhed_production_handler",
      "persistentPlacementMutated": false,
      "note": "Yalnız Yaxın LOD push keçidi üçün authoritative qonşu/icazə yoxlaması və qarşı sərhəddə server giriş koordinatı qaytarılır; Ev Dövlət worldPlacement dəyişdirilmir."
    },
    "global_states_v2_request": {
      "connected": true,
      "stateLifecycleSource": "dovlet_xerite_worldv2_lifecycle_adapteri",
      "layoutSource": "dovlet_xerite_worldv2_qlobal_layout",
      "topologySource": "dovlet_xerite_worldv2_topologiya",
      "layoutVersion": 1,
      "coordinateSpace": "normalized_0_1",
      "origin": "bottom_left",
      "backgroundId": "worldv2_qlobal_fon_v1",
      "backgroundAspectRatio": 0.5625,
      "capacity": 91,
      "note": "Yalnız açılmış Dövlətlər qaytarılır. Node mövqeləri serverdə versiyalanmış statik layout-dan gəlir; əlaqələr authoritative topology-dən gəlir, topology verilmədikdə legacy layout fallback saxlanılır. Prezident/ad/bayraq yalnız real metadata mənbəyi olduqda doldurulur."
    },
    "global_states_v2_search_request": {
      "connected": true,
      "source": "global_states_v2_request payload",
      "readOnly": true,
      "acceptedStateCodeFormats": [
        "1434",
        "State#1434",
        "state 1434"
      ],
      "note": "Axtarış yalnız authoritative lifecycle payload-da olan açıq Dövlətlər içində dəqiq State ID tapır; player worldPlacement mutasiya edilmir."
    },
    "state_map_v2_base_teleport_request": {
      "connected": true,
      "stateSource": "oyun_state_daimilik_korpu",
      "mutationSource": "oyun_state_mutasiya_postgres",
      "collisionSource": "dovlet_baza_kataloqu_postgres + dovlet_xerite_worldv2_resurs_provider",
      "transactional": true,
      "persistentPlacementMutated": true,
      "note": "Client yalnız eyni Dövlət daxilində tam koordinat təklif edir. Sərhəd, Prezident zonası, baza və resurs toqquşması serverdə yoxlanılır; qəbul ediləndə worldPlacement.baseX/baseZ PostgreSQL transaction-da dəyişir."
    }
