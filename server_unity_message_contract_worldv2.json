{
  "contract": "rdc_state_map_worldv2",
  "version": 2,
  "status": "partial_production_connected",
  "productionConnected": false,
  "productionConnections": {
    "state_map_v2_info_request": {
      "connected": true,
      "stateSource": "oyun_state_daimilik_korpu",
