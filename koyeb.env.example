# Koyeb / production multi-instance runtime environment
# Secrets are intentionally placeholders. Configure their real values in the platform.

NODE_ENV=production
RUNTIME_MULTI_INSTANCE=1

REDIS_REQUIRED=1
REDIS_URL=rediss://<redis-host>:<port>
REDIS_NAMESPACE=rdc:v2
REDIS_PRESENCE_TTL_SECONDS=90
REDIS_PRESENCE_REFRESH_MS=30000
REDIS_LOCK_TTL_MS=30000
REDIS_LOCK_WAIT_MS=5000
REDIS_LOCK_RETRY_MS=60

DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>

# PORT is normally injected by the hosting platform.
# KOYEB_INSTANCE_ID is expected to be injected by Koyeb and is used for instance routing.
